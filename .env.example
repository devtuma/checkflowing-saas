# Copie este arquivo para .env e preencha com suas credenciais reais do Supabase.
# Este arquivo não deve ser commitado no controle de versão (Git).

# A URL do seu projeto Supabase (ex: https://xxxxx.supabase.co)
# Você pode encontrar isso no painel do Supabase em Project Settings > API > Project URL
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# A chave anônima (anon key) do seu projeto Supabase
# Você pode encontrar isso no painel do Supabase em Project Settings > API > Project API Keys
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-aqui"